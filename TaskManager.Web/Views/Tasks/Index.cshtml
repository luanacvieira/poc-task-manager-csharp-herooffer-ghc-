@model TaskManager.Web.Models.TasksIndexViewModel

@{
    ViewData["Title"] = "Gerenciador de Tarefas";
}

<h1>Gerenciador de Tarefas</h1>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <p>@Model.SuccessMessage</p>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p>@Model.ErrorMessage</p>
}

<p>Inclua uma tarefa no formulario abaixo. A lista nao sera atualizada automaticamente.</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="NewTask.UserId" type="hidden" value="default-user" />

    <div>
        <label asp-for="NewTask.Title">Titulo</label><br />
        <input asp-for="NewTask.Title" />
        <span asp-validation-for="NewTask.Title"></span>
    </div>

    <div>
        <label asp-for="NewTask.Description">Descricao</label><br />
        <textarea asp-for="NewTask.Description" rows="3"></textarea>
        <span asp-validation-for="NewTask.Description"></span>
    </div>

    <div>
        <label asp-for="NewTask.Priority">Prioridade</label><br />
        <select asp-for="NewTask.Priority" asp-items="Html.GetEnumSelectList<TaskManager.Web.Models.Priority>()"></select>
        <span asp-validation-for="NewTask.Priority"></span>
    </div>

    <div>
        <label asp-for="NewTask.Category">Categoria</label><br />
        <select asp-for="NewTask.Category" asp-items="Html.GetEnumSelectList<TaskManager.Web.Models.Category>()"></select>
        <span asp-validation-for="NewTask.Category"></span>
    </div>

    <div>
        <label asp-for="NewTask.DueDate">Data de vencimento</label><br />
        <input asp-for="NewTask.DueDate" type="date" />
        <span asp-validation-for="NewTask.DueDate"></span>
    </div>

    <div>
        <label asp-for="NewTask.AssignedTo">Atribuida a</label><br />
        <input asp-for="NewTask.AssignedTo" />
        <span asp-validation-for="NewTask.AssignedTo"></span>
    </div>

    <div>
        <label asp-for="NewTask.Completed">Concluida</label>
        <input asp-for="NewTask.Completed" type="checkbox" />
    </div>

    <div>
        <button type="submit">Salvar</button>
    </div>
</form>

<p>Para ver a lista atualizada, pressione refresh no navegador.</p>

<table>
    <thead>
        <tr>
            <th>Titulo</th>
            <th>Prioridade</th>
            <th>Categoria</th>
            <th>Data de Vencimento</th>
            <th>Atribuida a</th>
            <th>Status</th>
            <th>Acoes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model.Tasks)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Priority</td>
                <td>@task.Category</td>
                <td>@(task.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                <td>@(task.AssignedTo ?? "-")</td>
                <td>@(task.Completed ? "Concluida" : "Pendente")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@task.Id">Editar</a>
                    |
                    <a asp-action="Delete" asp-route-id="@task.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
