<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskManager.Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskManager.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <p><a asp-area="" asp-controller="Tasks" asp-action="Index">Lista de tarefas</a></p>
        <p><a asp-area="" asp-controller="Home" asp-action="Index">Home</a> | <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
        <hr />
    </header>
    <main role="main">
            @RenderBody()
    </main>

    <footer>
        <hr />
        <p>&copy; 2025 - TaskManager.Web</p>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
